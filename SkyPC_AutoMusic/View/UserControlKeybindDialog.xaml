<UserControl x:Class="SkyPC_AutoMusic.View.UserControlKeybindDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:SkyPC_AutoMusic.View"
             xmlns:loc="clr-namespace:SkyPC_AutoMusic.Properties"
             xmlns:viewmodel="clr-namespace:SkyPC_AutoMusic.ViewModel"
             d:DataContext="{d:DesignInstance Type=viewmodel:KeybindDialogViewModel}"
             mc:Ignorable="d" 
             MinWidth="440"
             d:DesignHeight="360" d:DesignWidth="440" d:Background="{DynamicResource MaterialDesignPaper}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!--Header-->
        <StackPanel Orientation="Horizontal">
            <materialDesign:PackIcon Width="25" Height="25" Margin="10" Kind="KeyboardOutline"/>
            <TextBlock VerticalAlignment="Center" FontSize="16" Text="{x:Static loc:Resources.Keybind_Title}"/>
        </StackPanel>

        <!--Tips-->
        <TextBlock Grid.Row="1" Margin="10,4,10,10" Opacity="0.7" TextWrapping="Wrap" Text="{x:Static loc:Resources.Keybind_Tips}"/>

        <!--键位格子-->
        <ItemsControl Grid.Row="2" ItemsSource="{Binding Slots}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="5"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Style="{StaticResource MaterialDesignFlatButton}" Width="72" Height="62" Margin="4" Click="Slot_Click">
                        <StackPanel>
                            <TextBlock HorizontalAlignment="Center" FontSize="10" Opacity="0.6" Text="{Binding NoteLabel}"/>
                            <TextBlock HorizontalAlignment="Center" FontSize="16" FontWeight="Bold" Text="{Binding KeyName}"/>
                        </StackPanel>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!--按钮-->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{DynamicResource MaterialDesignFlatButton}" Margin="6" Content="{x:Static loc:Resources.Keybind_Reset}" Command="{Binding ResetCommand}"/>
            <Button IsDefault="True" Style="{DynamicResource MaterialDesignFlatButton}" Margin="6" Content="{x:Static loc:Resources.Options_Confirm}" Command="{Binding ConfirmCommand}"/>
        </StackPanel>
    </Grid>
</UserControl>
