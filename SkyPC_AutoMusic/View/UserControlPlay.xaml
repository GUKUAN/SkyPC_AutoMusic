<UserControl x:Class="SkyPC_AutoMusic.View.UserControlPlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:SkyPC_AutoMusic.View"
             xmlns:loc="clr-namespace:SkyPC_AutoMusic.Properties"
             xmlns:theme="clr-namespace:SkyPC_AutoMusic.Theme"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:model="clr-namespace:SkyPC_AutoMusic.Model"
             d:DataContext="{d:DesignInstance Type=model:PlayViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="360" d:DesignWidth="560" d:Background="Transparent">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <!--标题（点击看曲谱信息）-->
        <TextBlock Style="{StaticResource PageTitle}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" Cursor="Hand" Text="{Binding Headline}">
            <i:Interaction.Triggers>
                <i:EventTrigger EventName="MouseLeftButtonDown">
                    <i:InvokeCommandAction Command="{Binding ShowSheetInfoCommand}"/>
                </i:EventTrigger>
            </i:Interaction.Triggers>
        </TextBlock>

        <Grid Grid.Row="1" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <!--进度卡-->
                <Border Style="{StaticResource GlassCard}" Padding="16,14">
                    <StackPanel>
                        <Slider materialDesign:SliderAssist.OnlyShowFocusVisualWhileDragging="True" Height="22" Maximum="1" Value="{Binding SliderProgress}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                            <TextBlock Style="{StaticResource MutedText}" VerticalAlignment="Center" Text="{Binding CurrentTime}"/>
                            <TextBlock Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="4,0" Text="/"/>
                            <TextBlock Style="{StaticResource MutedText}" VerticalAlignment="Center" Text="{Binding TotalTime}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!--控制卡-->
                <Border Style="{StaticResource GlassCard}" Padding="16" Margin="0,12,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Style="{StaticResource MaterialDesignIconButton}" theme:UiMotion.PressScale="True" Width="56" Height="56" Margin="8,0"
                                    Background="{DynamicResource GlassSurfaceHoverBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                    Command="{Binding PreviousSongCommand}" ToolTip="{x:Static loc:Resources.Play_Btn_PreviousMusic}">
                                <materialDesign:PackIcon Width="26" Height="26" Kind="SkipPrevious" />
                            </Button>
                            <Button Style="{StaticResource MaterialDesignIconButton}" theme:UiMotion.PressScale="True" Width="68" Height="68" Margin="8,0"
                                    Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentForegroundBrush}"
                                    Command="{Binding TogglePlayCommand}" ToolTip="{Binding TogglePlayButtonLabel}">
                                <materialDesign:PackIcon Width="32" Height="32" Kind="{Binding TogglePlayButtonIcon}" />
                            </Button>
                            <Button Style="{StaticResource MaterialDesignIconButton}" theme:UiMotion.PressScale="True" Width="56" Height="56" Margin="8,0"
                                    Background="{DynamicResource GlassSurfaceHoverBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                    Command="{Binding NextSongCommand}" ToolTip="{x:Static loc:Resources.Play_Btn_NextMusic}">
                                <materialDesign:PackIcon Width="26" Height="26" Kind="SkipNext" />
                            </Button>
                        </StackPanel>

                        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                            <Button Style="{StaticResource MaterialDesignFlatButton}" theme:UiMotion.PressScale="True" Foreground="{DynamicResource TextPrimaryBrush}" Command="{Binding SwitchModeCommand}" Content="{Binding PlayModeLabel}" Cursor="Hand"/>
                            <Border Margin="8,0,0,0" CornerRadius="12" Padding="10,4" Background="{DynamicResource GlassSurfaceHoverBrush}">
                                <TextBlock Style="{StaticResource MutedText}" VerticalAlignment="Center" Text="{Binding SpeedLabel}"/>
                            </Border>
                            <ToggleButton Margin="8,0,0,0" VerticalAlignment="Center" theme:UiMotion.PressScale="True" IsChecked="{Binding HumanizeEnabled}" Content="{x:Static loc:Resources.Play_Humanize_Toggle}"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!--速度卡（竖向滑块）-->
            <Border Grid.Column="1" Style="{StaticResource GlassCard}" Margin="12,0,0,0" Padding="10,14" Width="64">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Style="{StaticResource MutedText}" HorizontalAlignment="Center" Text="{x:Static loc:Resources.Play_SpeedLabel}"/>
                    <Slider materialDesign:SliderAssist.OnlyShowFocusVisualWhileDragging="True" Orientation="Vertical" Value="{Binding SliderSpeedModifier}"
                            TickFrequency="1" TickPlacement="Both" Maximum="20" Minimum="1" MinHeight="120"
                            Style="{StaticResource MaterialDesignDiscreteSlider}" Margin="0,10" HorizontalAlignment="Center"/>
                    <TextBlock Style="{StaticResource BodyText}" HorizontalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Text="{Binding SpeedLabel}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
