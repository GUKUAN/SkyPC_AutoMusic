<UserControl x:Class="SkyPC_AutoMusic.View.UserControlMessageDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:SkyPC_AutoMusic.View"
             xmlns:loc="clr-namespace:SkyPC_AutoMusic.Properties"
             mc:Ignorable="d"
             x:Name="Dialog"
             MaxWidth="420"
             MaxHeight="240"
             d:DesignHeight="200" d:DesignWidth="420" Background="Transparent">
    <Border Style="{StaticResource GlassCard}" Padding="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <DockPanel>
                <materialDesign:PackIcon Kind="MessageAlertOutline" DockPanel.Dock="Left" Margin="16,16,6,16" Height="24" Width="24" Foreground="{DynamicResource AccentBrush}"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="Message" Margin="12" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" Grid.Row="0" TextWrapping="Wrap" MinWidth="200"/>
                </ScrollViewer>
            </DockPanel>
            <Button Grid.Row="1" IsDefault="True" Style="{DynamicResource MaterialDesignFlatButton}" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right" Margin="6" Content="{x:Static loc:Resources.Options_Confirm}" Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}"/>
        </Grid>
    </Border>
</UserControl>
