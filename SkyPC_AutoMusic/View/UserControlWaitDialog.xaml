<UserControl x:Class="SkyPC_AutoMusic.View.UserControlWaitDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SkyPC_AutoMusic.View"
             mc:Ignorable="d" 
             d:DesignHeight="140" d:DesignWidth="200" Background="Transparent">
    <Border Style="{StaticResource GlassCard}" Padding="14">
        <StackPanel>
            <ProgressBar Width="26" Height="26" Margin="10" HorizontalAlignment="Center" Style="{StaticResource MaterialDesignCircularProgressBar}" IsIndeterminate="True"/>
            <Label x:Name="Message" HorizontalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="8,4,0,0">
                <Label Content="{Binding Progress}" Foreground="{DynamicResource TextMutedBrush}"/>
                <Label Content="/" Foreground="{DynamicResource TextMutedBrush}"/>
                <Label x:Name="Total" Foreground="{DynamicResource TextMutedBrush}"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
