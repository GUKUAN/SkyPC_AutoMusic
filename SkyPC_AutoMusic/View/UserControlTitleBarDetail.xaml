<UserControl x:Class="SkyPC_AutoMusic.View.UserControlTitleBarDetail"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SkyPC_AutoMusic.View"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" 
             xmlns:theme="clr-namespace:SkyPC_AutoMusic.Theme"
             xmlns:viewmodel="clr-namespace:SkyPC_AutoMusic.ViewModel" 
             d:DataContext="{d:DesignInstance Type=viewmodel:TitleBarDetailViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="44" d:DesignWidth="600" Background="Transparent">
    <Border Background="{DynamicResource GlassHeaderBrush}" BorderBrush="{DynamicResource GlassStrokeSoftBrush}" BorderThickness="0,0,0,1">
        <DockPanel>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" Cursor="">
                <!--展开按钮-->
                <Button Style="{StaticResource MaterialDesignIconButton}" Foreground="{DynamicResource TextPrimaryBrush}" theme:UiMotion.PressScale="True" Command="{Binding WindowExpandCommand}" WindowChrome.IsHitTestVisibleInChrome="True">
                    <materialDesign:PackIcon Kind="ChevronDoubleDown"/>
                </Button>
            </StackPanel>
            <!--图标-->
            <Image Source="/Logo/app-icon.png" Height="24" Width="24" Margin="12,0,6,0" DockPanel.Dock="Left"/>
            <!--播放控件-->
            <Button Style="{StaticResource MaterialDesignIconButton}" Foreground="{DynamicResource TextPrimaryBrush}" theme:UiMotion.PressScale="True" Command="{Binding PreviousSongCommand}" Width="28" Height="28" WindowChrome.IsHitTestVisibleInChrome="True">
                <materialDesign:PackIcon Kind="SkipPrevious" />
            </Button>
            <Button Style="{StaticResource MaterialDesignIconButton}" Foreground="{DynamicResource AccentBrush}" theme:UiMotion.PressScale="True" Command="{Binding PauseSongCommand}" Width="28" Height="28" WindowChrome.IsHitTestVisibleInChrome="True">
                <materialDesign:PackIcon Kind="{Binding TogglePlayButtonIcon}" />
            </Button>
            <Button Style="{StaticResource MaterialDesignIconButton}" Foreground="{DynamicResource TextPrimaryBrush}" theme:UiMotion.PressScale="True" Command="{Binding NextSongCommand}" Width="28" Height="28" WindowChrome.IsHitTestVisibleInChrome="True">
                <materialDesign:PackIcon Kind="SkipNext" />
            </Button>
            <!--标签-->
            <Label VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Width="42" Foreground="{DynamicResource TextMutedBrush}" Content="{Binding CurrentTime}"/>
            <Label VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" Content="/"/>
            <Label VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Width="42" Foreground="{DynamicResource TextMutedBrush}" Content="{Binding TotalTime}"/>
            <TextBlock Padding="12,0" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding Headline}" VerticalAlignment="Center"/>
        </DockPanel>
    </Border>
</UserControl>
