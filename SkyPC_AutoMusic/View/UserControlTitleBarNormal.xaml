<UserControl x:Class="SkyPC_AutoMusic.View.UserControlTitleBarNormal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:SkyPC_AutoMusic.View" 
             xmlns:loc="clr-namespace:SkyPC_AutoMusic.Properties"
             xmlns:theme="clr-namespace:SkyPC_AutoMusic.Theme"
             xmlns:viewmodel="clr-namespace:SkyPC_AutoMusic.ViewModel" 
             d:DataContext="{d:DesignInstance Type=viewmodel:TitleBarNormalViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="44" d:DesignWidth="600" Background="Transparent">
    <Border Background="{DynamicResource GlassHeaderBrush}" BorderBrush="{DynamicResource GlassStrokeSoftBrush}" BorderThickness="0,0,0,1">
        <DockPanel>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" Cursor="">
                <!--收起按钮-->
                <Button Style="{StaticResource MaterialDesignIconButton}" Foreground="{DynamicResource TextPrimaryBrush}" theme:UiMotion.PressScale="True" Command="{Binding WindowShrinkCommand}" WindowChrome.IsHitTestVisibleInChrome="True">
                    <materialDesign:PackIcon Kind="ChevronDoubleUp"/>
                </Button>
                <!--缩小按钮-->
                <Button Style="{StaticResource MaterialDesignIconButton}" Foreground="{DynamicResource TextPrimaryBrush}" theme:UiMotion.PressScale="True" Command="{Binding WindowMinimizeCommand}" WindowChrome.IsHitTestVisibleInChrome="True">
                    <materialDesign:PackIcon Kind="Minimize" />
                </Button>
                <!--关闭按钮-->
                <Button Style="{StaticResource MaterialDesignIconButton}" Foreground="{DynamicResource TextPrimaryBrush}" theme:UiMotion.PressScale="True" Command="{Binding WindowCloseCommand}" WindowChrome.IsHitTestVisibleInChrome="True">
                    <materialDesign:PackIcon Kind="Close" />
                </Button>
            </StackPanel>
            <!--图标-->
            <Image Source="/Logo/app-icon.png" Height="24" Width="24" Margin="12,0,6,0" DockPanel.Dock="Left"/>
            <!--标签-->
            <TextBlock Padding="6,0" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Text="{x:Static loc:Resources.Main_WindowTitle}" VerticalAlignment="Center"/>
        </DockPanel>
    </Border>
</UserControl>
