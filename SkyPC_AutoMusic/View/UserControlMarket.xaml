<UserControl x:Class="SkyPC_AutoMusic.View.UserControlMarket"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:SkyPC_AutoMusic.View"
             xmlns:loc="clr-namespace:SkyPC_AutoMusic.Properties"
             xmlns:viewmodel="clr-namespace:SkyPC_AutoMusic.ViewModel"
             d:DataContext="{d:DesignInstance Type=viewmodel:MarketViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="400" d:DesignWidth="600" d:Background="#FFE5E5E5">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <!--标题与状态-->
        <DockPanel>
            <TextBlock DockPanel.Dock="Left" Margin="10" Foreground="{DynamicResource PrimaryHueMidBrush}" FontSize="20" Text="{x:Static loc:Resources.Market_Header}"/>
            <TextBlock VerticalAlignment="Center" HorizontalAlignment="Right" Opacity="0.7" TextTrimming="CharacterEllipsis" Text="{Binding StatusText}"/>
        </DockPanel>

        <!--工具栏-->
        <DockPanel Grid.Row="1" Margin="0,0,0,8">
            <!--刷新-->
            <Button DockPanel.Dock="Right" Style="{StaticResource MaterialDesignIconButton}" Background="{DynamicResource MaterialDesignTextFieldBoxBackground}" Margin="4,0" Command="{Binding RefreshCommand}" ToolTip="{x:Static loc:Resources.Market_Refresh}" Cursor="Hand">
                <materialDesign:PackIcon Kind="Refresh"/>
            </Button>
            <!--来源仓库-->
            <Button DockPanel.Dock="Right" Style="{StaticResource MaterialDesignIconButton}" Background="{DynamicResource MaterialDesignTextFieldBoxBackground}" Margin="4,0" Command="{Binding OpenRepoCommand}" ToolTip="{x:Static loc:Resources.Market_Repo}" Cursor="Hand">
                <materialDesign:PackIcon Kind="Github"/>
            </Button>
            <!--批量下载-->
            <Button DockPanel.Dock="Right" Style="{StaticResource MaterialDesignFlatButton}" Margin="4,0" Command="{Binding DownloadAllCommand}" Content="{x:Static loc:Resources.Market_DownloadAll}" Cursor="Hand"/>
            <!--分类-->
            <ComboBox Width="130" Margin="4,0" VerticalAlignment="Center" ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup, Mode=TwoWay}" materialDesign:HintAssist.Hint="{x:Static loc:Resources.Market_Category}"/>
            <!--子类-->
            <ComboBox Width="130" Margin="4,0" VerticalAlignment="Center" ItemsSource="{Binding Subs}" SelectedItem="{Binding SelectedSub, Mode=TwoWay}" materialDesign:HintAssist.Hint="{x:Static loc:Resources.Market_SubCategory}"/>
            <!--搜索-->
            <TextBox Margin="4,0" VerticalAlignment="Center" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="{x:Static loc:Resources.Market_SearchHint}" materialDesign:TextFieldAssist.HasClearButton="True" Style="{StaticResource MaterialDesignFilledTextBox}"/>
        </DockPanel>

        <!--列表-->
        <Border Grid.Row="2" BorderBrush="Gray" BorderThickness="2" CornerRadius="5" Opacity="0.95">
            <Grid>
                <ListView x:Name="ItemsList" ItemsSource="{Binding View}" SelectedItem="{Binding SelectedItem}" Background="{DynamicResource MaterialDesignTextFieldBoxBackground}">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="{x:Static loc:Resources.Play_Info_Name}" Width="300" DisplayMemberBinding="{Binding Name}"/>
                            <GridViewColumn Header="{x:Static loc:Resources.Market_Category}" Width="140" DisplayMemberBinding="{Binding Group}"/>
                            <GridViewColumn Header="{x:Static loc:Resources.Market_SubCategory}" Width="120" DisplayMemberBinding="{Binding Sub}"/>
                            <GridViewColumn Header="{x:Static loc:Resources.Market_Col_Size}" Width="70" DisplayMemberBinding="{Binding SizeText}"/>
                            <GridViewColumn Header="{x:Static loc:Resources.Market_Downloaded}" Width="70" DisplayMemberBinding="{Binding DownloadMark}"/>
                            <GridViewColumn Header="" Width="130">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource MaterialDesignFlatButton}" Content="{x:Static loc:Resources.Market_Download}" Click="Download_Click" Cursor="Hand"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.6" Text="{x:Static loc:Resources.Market_Empty}"
                           Visibility="{Binding EmptyVisible, Converter={StaticResource BoolToVis}}"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
